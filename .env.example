# Claves de IA (solo en el servidor, nunca en el navegador)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Modelos (los fija el servidor; el navegador no puede elegirlos)
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image

# Cloudflare Turnstile (widget con el dominio de la app)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
# Solo en local, con las claves de prueba de Cloudflare: acepta sus respuestas de prueba
# TURNSTILE_PRUEBAS=1

# Firma de la cookie de sesión: cadena aleatoria larga (p. ej. openssl rand -base64 48)
SESSION_SECRET=

# Cupos diarios globales (protegen la clave de Gemini compartida con firmas)
CUPO_DIARIO_SEO=500
CUPO_DIARIO_EDICION=100

PORT=3000
# URL donde se sirve la app (sin barra final)
ALLOWED_ORIGIN=http://localhost:3000
# Producción:
# ALLOWED_ORIGIN=https://altdone.platita.es
